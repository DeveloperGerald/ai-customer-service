# =============================================================
# 手串售后智能客服 Backend 环境变量模板 (.env.example)
# =============================================================
# 使用方法：
#   cp backend/.env.example backend/.env
#   按下面注释改完后，重启 backend 即可生效。
#
# Pydantic Settings 读取规则：
#   顶层字段：直接写 KEY=value （例：APP_ENV=local）
#   嵌套对象：用 __ 做分隔符（例：DB__URL=... 对应 settings.db.url）
# =============================================================

# =============================================================
# 基础配置
# =============================================================
APP_ENV=local
APP_NAME=ai-customer-service-backend
LOG_LEVEL=INFO
JSON_LOG=false
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]

# =============================================================
# 数据库（PostgreSQL + pgvector）
#   推荐：docker compose up -d 后直接用下面默认值
# =============================================================
DB__URL=postgresql+psycopg://ai_cs:ai_cs_pw@localhost:5432/ai_customer_service
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_RECYCLE=1800
DB__ECHO=false

# =============================================================
# Redis（会话缓存 + 幂等 key TTL）
# =============================================================
REDIS__URL=redis://:redis_pw@localhost:6379/0
REDIS__DECODE_RESPONSES=true
REDIS__SOCKET_CONNECT_TIMEOUT=2.0
REDIS__SOCKET_TIMEOUT=3.0

# =============================================================
# 安全：演示用 JWT（面试本地开发，生产请换 256-bit 随机串）
# =============================================================
SECURITY__DEMO_TOKEN_SECRET=replace-me-with-32-chars-random-secret-xxxx
SECURITY__DEMO_TOKEN_TTL_SECONDS=2592000

# =============================================================
# LLM / Embedding
#   MOCK 模式：不需要真 Key，节点内模板直接出回复，方便 pytest
#   OPENAI 模式：填下面 Key 才会真调大模型
# =============================================================
LLM__PROVIDER=mock          # mock | openai
LLM__EMBEDDING_PROVIDER=mock
# 当 LLM__PROVIDER=openai 时填以下：
# LLM__OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM__OPENAI_BASE_URL=https://api.openai.com/v1
LLM__CHAT_MODEL=gpt-4o-mini
LLM__CHAT_TEMPERATURE=0.2
LLM__CHAT_MAX_TOKENS=1024
LLM__EMBEDDING_MODEL=text-embedding-3-small
LLM__EMBEDDING_DIM=1536
LLM__EMBEDDING_BATCH_SIZE=32
LLM__EMBEDDING_REQUEST_TIMEOUT=15.0
LLM__MOCK_EMBEDDING_VALUE=0.01

# =============================================================
# 🧪 LangSmith 可观测（面试展示：节点 DAG + 每步输入输出 + Token 耗时 + 成本）
#   ⚠️  不填 LANGSMITH__API_KEY 或 LANGSMITH__TRACING_ENABLED=false 时 100% 静默，
#       不会写日志、不会联网、pytest 完全离线（conftest.py 强制 tracing_enabled=false）
#
# 怎么拿 Key：
#   1) 登录 https://smith.langchain.com/  → 右上角头像 → Settings → API Keys → Create API Key
#   2) 回到 Projects 页，新建 Project，名字填到下面 LANGSMITH__PROJECT
#   3) 启动 backend，日志会出现 langsmith.enabled project=xxx endpoint=...
#      再在 UI 上发一次客服消息，LangSmith 页面就能看到整条 trace 了
# =============================================================
LANGSMITH__TRACING_ENABLED=false   # 改成 true + 填下面的 API Key 就生效
LANGSMITH__API_KEY=
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__PROJECT=ai-customer-service-demo

# =============================================================
# 离线质量评估（LangSmith Experiment，「评估测试」页手动触发）
#   JUDGE_MODEL / JUDGE_API_KEY / JUDGE_BASE_URL 留空时复用主聊天模型
# =============================================================
EVALUATION__DATASET_NAME=ai-cs-golden
EVALUATION__JUDGE_MODEL=
EVALUATION__JUDGE_API_KEY=
EVALUATION__JUDGE_BASE_URL=
EVALUATION__CONCURRENCY=4

# =============================================================
# Agent 运行参数（一般不用改）
# =============================================================
AGENT__MAX_GRAPH_STEPS=20
AGENT__CLARIFICATION_MAX_COUNT=3
AGENT__INTENT_CONFIDENCE_THRESHOLD=0.7
AGENT__RAG_TOP_K=4
AGENT__RAG_SIMILARITY_THRESHOLD=0.5
AGENT__PENDING_ACTION_TTL_SECONDS=1800
AGENT__TOOL_DEFAULT_TIMEOUT_SECONDS=15.0
