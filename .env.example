# ============================================================
# 手串售后智能客服 Agent - 环境变量示例
# 复制本文件为 .env 后按需填写。真实密钥禁止提交到 git。
# 嵌套字段使用双下划线 __，例如 DB__URL=...
# ============================================================

# -------- 基础 --------
APP_ENV=local
APP_NAME=ai-customer-service-backend
LOG_LEVEL=INFO
JSON_LOG=false

# -------- 数据库（必填）--------
# PostgreSQL + pgvector。启动 Compose 时可与 docker-compose.yml 的 credentials 保持一致
DB__URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_cs_demo
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_RECYCLE=1800
DB__ECHO=false

# -------- Redis（必填）--------
REDIS__URL=redis://localhost:6379/0
REDIS__SOCKET_CONNECT_TIMEOUT=2.0
REDIS__SOCKET_TIMEOUT=3.0

# -------- 安全（必填）--------
# DEMO_TOKEN_SECRET 至少 32 字符，生产级建议随机生成
# 注意：前端 src/demo-tokens.ts 中的 9 个演示 token 是按下面这个默认值签名的。
#       如果你改了 SECRET，前端 hardcode 的 9 个 token 会失效，需要重新生成。
SECURITY__DEMO_TOKEN_SECRET=change-me-to-a-random-32-chars-string-please
SECURITY__DEMO_TOKEN_TTL_SECONDS=2592000
SECURITY__REQUEST_ID_HEADER=X-Request-Id
SECURITY__TENANT_ID_HEADER=X-Tenant-Id
SECURITY__AUTH_HEADER=Authorization

# -------- 大模型与 Embedding（强依赖，API Key 必填，未配置则启动失败）--------
# 仅支持 OpenAI 兼容协议；以下默认按智谱 GLM 配置（也可换成 OpenAI/DeepSeek 等兼容端点）
LLM__PROVIDER=openai
LLM__EMBEDDING_PROVIDER=openai
LLM__OPENAI_API_KEY=
LLM__OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM__CHAT_MODEL=glm-4-flash
LLM__CHAT_TEMPERATURE=0.2
LLM__CHAT_MAX_TOKENS=1024
LLM__EMBEDDING_MODEL=embedding-3
LLM__EMBEDDING_DIM=1024
LLM__EMBEDDING_BATCH_SIZE=32
LLM__EMBEDDING_REQUEST_TIMEOUT=15.0

# -------- LangSmith 可观测（可空，留空则自动降级不启用）--------
LANGSMITH__API_KEY=
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__PROJECT=ai-customer-service-demo
LANGSMITH__TRACING_ENABLED=false

# -------- 离线质量评估（LangSmith Experiment，页面手动触发）--------
EVALUATION__DATASET_NAME=ai-cs-golden
# Judge 模型留空则复用主聊天模型；后期可换其他模型/厂商
EVALUATION__JUDGE_MODEL=
EVALUATION__JUDGE_API_KEY=
EVALUATION__JUDGE_BASE_URL=
EVALUATION__CONCURRENCY=4

# -------- Agent 参数 --------
AGENT__MAX_GRAPH_STEPS=20
AGENT__CLARIFICATION_MAX_COUNT=3
AGENT__INTENT_CONFIDENCE_THRESHOLD=0.7
AGENT__RAG_TOP_K=4
AGENT__RAG_SIMILARITY_THRESHOLD=0.5
AGENT__PENDING_ACTION_TTL_SECONDS=1800
AGENT__TOOL_DEFAULT_TIMEOUT_SECONDS=15.0

# -------- CORS（本地开发可选）--------
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
